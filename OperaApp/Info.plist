<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>We need camera access to scan your opera tickets and playbills for quick logging.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>We use your location to show nearby opera houses and performances.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Add opera performances to your calendar so you never miss a show.</string>
	<key>NEON_DATA_API_URL</key>
	<string>$(NEON_DATA_API_URL)</string>
	<key>NEON_AUTH_URL</key>
	<string>$(NEON_AUTH_URL)</string>
	<key>NEON_AUTH_ORIGIN</key>
	<string>$(NEON_AUTH_ORIGIN)</string>
	<!-- Registers operaapp:// so the auth Origin is a scheme this app owns,
	     rather than a URL belonging to somebody else's site. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.operaapp.OperaApp.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>operaapp</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

