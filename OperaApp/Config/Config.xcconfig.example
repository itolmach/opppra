// Copy this file to Config.xcconfig (same folder) and fill in your own Neon
// project's values. Config.xcconfig is gitignored, so your values never get
// committed. See ../../NEON_SETUP.md for where to find each one.
//
// There is no API key here. Supabase needed an anon key; Neon's Data API
// does not -- an unauthenticated request runs as the `anonymous` Postgres
// role and a signed-in one carries a JWT. Either way the authorization
// boundary is row level security in the database, not a secret in the app.
//
// xcconfig treats // as a comment everywhere, including inside a value, so
// the $() below splits the "//" in https:// and is load-bearing. Without it
// each URL is silently truncated to "https:".

NEON_DATA_API_URL = https:/$()/YOUR-ENDPOINT.apirest.REGION.aws.neon.tech/opera/rest/v1
NEON_AUTH_URL = https:/$()/YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/opera/auth

// Sent as the Origin header on every auth call. Better Auth checks it
// against the project's trusted origins, so this exact value must be added
// there (Neon console -> Auth -> trusted domains) or sign-in fails with
// INVALID_ORIGIN. It also has to match a URL scheme this app registers, in
// Info.plist under CFBundleURLTypes.
NEON_AUTH_ORIGIN = operaapp:/$()/auth
